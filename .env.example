# Copy to .env and adjust. Never commit .env.

# --- server ---
APP_ENV=development
HOST=127.0.0.1
PORT=8000
# Comma-separated list of allowed frontend origins (Vite dev server default shown)
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# --- model ---
# Path to the trained checkpoint (relative paths are resolved from backend/)
MODEL_PATH=models/best_model.pth
# DEMO_MODE: auto  = demo only while no valid checkpoint is loaded (recommended)
#            true  = always simulated, even if a checkpoint exists
#            false = never simulate: inference returns 503 until a checkpoint loads
DEMO_MODE=auto
# auto | cpu | cuda
DEVICE=auto
# Must match how the checkpoint was trained (segmentation_models_pytorch names)
MODEL_ARCHITECTURE=Unet
MODEL_ENCODER=resnet34
# imagenet = (x/255 - mean)/std ; none = x/255 only.  Must match training preprocessing.
NORMALIZE=imagenet
PREDICTION_THRESHOLD=0.5
TILE_SIZE=512
TILE_OVERLAP=64
INFERENCE_BATCH_SIZE=4

# --- limits ---
MAX_UPLOAD_SIZE_MB=100
# Reject rasters above this many pixels (25,000,000 = 5000x5000)
MAX_IMAGE_PIXELS=25000000
MAX_GEOJSON_FEATURES=200000
UPLOAD_TTL_HOURS=24

# --- polygonization ---
MIN_BUILDING_AREA_M2=10
MIN_BUILDING_AREA_PX=30
SIMPLIFY_TOLERANCE_PX=0.7

# --- density ---
GRID_CELL_SIZE_M=250
MAX_GRID_CELLS=20000

# --- logging ---
LOG_LEVEL=INFO
LOG_JSON=false
